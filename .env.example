# =====================================================================
# Flowline environment
# =====================================================================
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# Leave every value blank (or delete .env.local entirely) and Flowline
# starts in DEMO MODE: a complete, fully interactive sample company that
# lives in your browser. No database, no sign-in.
# =====================================================================


# ---------------------------------------------------------------------
# Public — safe to expose. These are the only Supabase values the browser
# ever sees, and Row Level Security is what protects the data.
# ---------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------
# Server only — NEVER prefix this with NEXT_PUBLIC_ and never commit it.
# It bypasses Row Level Security completely.
#
# Used by two things only:
#   * POST /api/team/invite  (inviting a teammate by email)
#   * npm run seed           (loading the sample company into your project)
#
# The app runs fine without it; you just cannot invite people from the UI.
# ---------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------
# Optional — AI drafting. Server only; never exposed to the browser.
#
# With this set, the wand button next to a job title asks Claude to draft
# the standard procedure, the checklist, and a realistic time estimate.
# Only the owner can trigger it, and it is a single call per press.
#
# Without it the button still works — it falls back to the built-in
# template, so nothing breaks and nobody is blocked.
#
# Get a key at https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------

ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------
# Optional — email domain used for the accounts `npm run seed` creates.
# Defaults to flowline.test.
# ---------------------------------------------------------------------

SEED_EMAIL_DOMAIN=
